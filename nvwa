#!/usr/bin/env python3
"""nvwa — Create, Language, and History for a small agent group.

History commands are forwarded to ``fgc`` (``lib/fg.py``). Create and
Language run here:

  nvwa spawn [--name NAME] [--agent CMD] [--mission TEXT]
  nvwa say NAME TEXT
  nvwa listen NAME [LINES]
  nvwa ps | list
  nvwa logs NAME [-f] [-n LINES]
  nvwa stop|kill NAME
  nvwa board
  nvwa ui [--host H] [--port N] [--no-open]

The default runner starts the backend CLI as a subprocess and records it
under ``.fg/agents/``. ``NVWA_RUNNER=tmux`` uses a tmux pane instead.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "lib"))

import fg  # noqa: E402
import runner  # noqa: E402
import ui  # noqa: E402

HELP = """\
nvwa — Create + Language + History

Create:
  spawn [--name NAME] [--agent CMD] [--mission TEXT]   start an agent
                                                       default command follows FG_BACKEND
  stop <name>                                          stop an agent
  kill <name>                                          alias of stop

Language:
  say <name> "<text>"                                  send a line to an agent
  listen <name> [lines=40]                             recent output
  logs <name> [-f] [-n lines]                          read or follow the log

Roster:
  ps                                                   agents, status, runner, backend
  list                                                 alias of ps
  board                                                agents + graph status
  ui [--host 127.0.0.1] [--port 8765] [--no-open]      local web panel

History (same as fgc):
  fact / intent / status / graph / dispatch / auto / ...

Runner:
  NVWA_RUNNER=subprocess   default. Logs: .fg/agents/<name>.log
                           State: .fg/agents/<name>.json
  NVWA_RUNNER=tmux         optional pane per agent (needs tmux; not native Windows)

Environment:
  NVWA_STORE        graph directory (default: .fg)
  NVWA_SESSION      tmux session (default: nvwa)
  NVWA_AGENT        default --agent command (overrides FG_BACKEND)
  NVWA_MAX_WORKERS  cap on running agents (default: 8)
  NVWA_UI_HOST      panel bind host (default: 127.0.0.1)
  NVWA_UI_PORT      panel bind port (default: 8765)
  FG_BACKEND        claude | codex | grok
  FG_CLAUDE_BIN FG_CODEX_BIN FG_GROK_BIN
  CODEX_API_KEY or OPENAI_API_KEY or FG_CODEX_API_KEY
  XAI_API_KEY or FG_GROK_API_KEY
"""


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("-h", "--help", "help"):
        print(HELP)
        return 0
    peeked = args
    if peeked[0] == "--store":
        peeked = peeked[2:]
    command = peeked[0] if peeked else ""
    if command not in _COMMANDS:
        return fg.main(args)
    try:
        store, rest = _take_store(args)
        return _COMMANDS[command](store, rest)
    except (runner.NvwaError, ValueError) as exc:
        sys.stderr.write(f"[nvwa] ERROR: {exc}\n")
        return 1
    except KeyboardInterrupt:
        return 130


def _take_store(args: list[str]) -> tuple[Path, list[str]]:
    store = Path(os.environ.get("NVWA_STORE", fg.DEFAULT_STORE))
    if args and args[0] == "--store":
        if len(args) < 3:
            raise runner.NvwaError("usage: nvwa --store DIR COMMAND")
        store = Path(args[1])
        args = args[2:]
    return store, args[1:]


def _need(args: list[str], what: str) -> str:
    if not args or args[0].startswith("-"):
        raise runner.NvwaError(what)
    return args[0]


def cmd_spawn(store: Path, args: list[str]) -> int:
    name = None
    agent = os.environ.get("NVWA_AGENT") or None
    mission = ""
    index = 0
    while index < len(args):
        item = args[index]
        if item in ("--name", "--agent", "--mission", "--minutes"):
            if index + 1 >= len(args):
                raise runner.NvwaError(f"spawn: {item} needs a value")
            value = args[index + 1]
            if item == "--name":
                name = value
            elif item == "--agent":
                agent = value
            elif item == "--mission":
                mission = value
            index += 2
            continue
        if item.startswith("-"):
            raise runner.NvwaError(f"spawn: unknown option {item}")
        if name is None:
            name = item
        else:
            raise runner.NvwaError(f"spawn: unexpected argument {item}")
        index += 1
    state = runner.spawn_agent(store, name=name, agent=agent, mission=mission)
    print(f"SPAWNED {state['name']} agent={state['backend']}")
    return 0


def cmd_say(store: Path, args: list[str]) -> int:
    if len(args) < 2:
        raise runner.NvwaError('usage: nvwa say <name> "<text>"')
    name, text = args[0], " ".join(args[1:])
    runner.say(store, name, text)
    sys.stderr.write(f"[nvwa] say -> {name}: {text[:60]}\n")
    return 0


def cmd_listen(store: Path, args: list[str]) -> int:
    if not args:
        raise runner.NvwaError("usage: nvwa listen <name> [lines]")
    name = args[0]
    lines = int(args[1]) if len(args) > 1 else 40
    state = runner.load_state(store, name)
    if state.get("runner") == "tmux":
        text = runner.tmux_listen(store, name, lines)
    else:
        text = runner.read_log_tail(store, name, lines)
    if text:
        print(text)
    return 0


def cmd_logs(store: Path, args: list[str]) -> int:
    follow = False
    lines = 40
    name = None
    index = 0
    while index < len(args):
        item = args[index]
        if item == "-f":
            follow = True
            index += 1
        elif item == "-n":
            if index + 1 >= len(args):
                raise runner.NvwaError("logs: -n needs a number")
            lines = int(args[index + 1])
            index += 2
        elif item.startswith("-"):
            raise runner.NvwaError(f"logs: unknown option {item}")
        elif name is None:
            name = item
            index += 1
        else:
            raise runner.NvwaError(f"logs: unexpected argument {item}")
    if name is None:
        raise runner.NvwaError("usage: nvwa logs <name> [-f] [-n lines]")
    runner.follow_log(store, name, lines=lines, follow=follow)
    return 0


def cmd_ps(store: Path, args: list[str]) -> int:
    if args:
        raise runner.NvwaError("usage: nvwa ps")
    print(runner.format_ps(runner.list_agents(store)))
    return 0


def cmd_stop(store: Path, args: list[str]) -> int:
    name = _need(args, "usage: nvwa stop <name>")
    if len(args) != 1:
        raise runner.NvwaError("usage: nvwa stop <name>")
    runner.stop_agent(store, name)
    sys.stderr.write(f"[nvwa] stopped {name}\n")
    return 0


def cmd_board(store: Path, args: list[str]) -> int:
    print("=== agents ===")
    print(runner.format_ps(runner.list_agents(store)))
    print()
    print("=== graph ===")
    graph = fg.Store(store)
    if graph.exists():
        print(fg.render_status(graph))
    else:
        print('(no graph — run: fgc init --goal "...")')
    return 0


def cmd_ui(store: Path, args: list[str]) -> int:
    host = os.environ.get("NVWA_UI_HOST", ui.DEFAULT_HOST)
    port = int(os.environ.get("NVWA_UI_PORT", str(ui.DEFAULT_PORT)))
    open_browser = True
    index = 0
    while index < len(args):
        item = args[index]
        if item == "--host":
            host = args[index + 1]
            index += 2
        elif item == "--port":
            port = int(args[index + 1])
            index += 2
        elif item == "--no-open":
            open_browser = False
            index += 1
        else:
            raise runner.NvwaError(f"ui: unknown option {item}")
    return ui.Panel(store).serve(host, port, open_browser=open_browser)


_COMMANDS = {
    "spawn": cmd_spawn,
    "say": cmd_say,
    "listen": cmd_listen,
    "logs": cmd_logs,
    "ps": cmd_ps,
    "list": cmd_ps,
    "stop": cmd_stop,
    "kill": cmd_stop,
    "board": cmd_board,
    "ui": cmd_ui,
}


if __name__ == "__main__":
    sys.exit(main())
